.title kicad schematic

.include 2N3819.lib
v1 net-_j1-pad2_ gnd  dc 0
j1 net-_j1-pad1_ net-_j1-pad2_ gnd 2N3819
v_u1 net-_u1-pad1_ net-_j1-pad1_ 0
v2 net-_u1-pad1_ gnd  dc 0
.dc  0e-00 0e-00 0e-00

* Control Statements 
.control
run
print allv > plot_data_v.txt
print alli > plot_data_i.txt
.endc
.end
