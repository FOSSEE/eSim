.title kicad schematic

.include IRF540N.lib
v1 net-_m1-pad2_ gnd  dc 0
v2 net-_u1-pad2_ gnd  dc 0
* u1 net-_m1-pad1_ net-_u1-pad2_ plot_i2
m1 net-_m1-pad1_ net-_m1-pad2_ gnd gnd IRF540N W=11 L=100u M=1
v_u1 net-_m1-pad1_ net-_u1-pad2_ 0
.dc v2 0e-00 10e-00 0.05e-00 v1 0e-00 8e-00 1e-00

* Control Statements 
.control
run
print allv > plot_data_v.txt
print alli > plot_data_i.txt
plot i(v_u1)
.endc
.end
