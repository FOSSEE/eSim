.title kicad schematic

.include TIP31C.lib
q1 /vce /ib gnd TIP31C
* u1 /vce net-_v2-pad1_ plot_i2
v2 net-_v2-pad1_ gnd  dc 0
i1 gnd /ib  dc 0
v_u1 /vce net-_v2-pad1_ 0
.dc v2 0e-00 10e-00 0.05e-00 i1 0e-00 100ue-00 10ue-00

* Control Statements 
.control
run
print allv > plot_data_v.txt
print alli > plot_data_i.txt
plot i(v_u1)
.endc
.end
