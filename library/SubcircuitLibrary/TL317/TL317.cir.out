.title kicad schematic

.include LM321.sub
.include NPN.lib
* u1 net-_i1-pad2_ net-_u1-pad2_ net-_r1-pad1_ port
r1 net-_r1-pad1_ net-_q2-pad3_ 0.1
q2 net-_i1-pad2_ net-_q1-pad3_ net-_q2-pad3_ Q2N2222
q1 net-_i1-pad2_ net-_q1-pad2_ net-_q1-pad3_ Q2N2222
x1 net-_i1-pad1_ net-_r1-pad1_ net-_i1-pad2_ net-_q1-pad2_ gnd LM321
v1 net-_i1-pad1_ net-_u1-pad2_ 1.25
i1 net-_i1-pad1_ net-_i1-pad2_ 50u
.tran 1e-06 1e-03 0e-00

* Control Statements 
.control
run
print allv > plot_data_v.txt
print alli > plot_data_i.txt
.endc
.end
