{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "authorization configuration v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "scope": {
      "const": "configuration-review-only"
    },
    "release_sha256": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9a-f]{64}$"
    },
    "lock_sha256": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9a-f]{64}$"
    },
    "approved_by": {
      "type": "string",
      "minLength": 1
    },
    "reference": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "scope",
    "release_sha256",
    "lock_sha256",
    "approved_by",
    "reference"
  ],
  "additionalProperties": false
}
