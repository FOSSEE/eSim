{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dependencies configuration v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "const": "proposed"
    },
    "source_snapshot_sha256": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9a-f]{64}$"
    },
    "architecture": {
      "const": "arm64"
    },
    "deployment_target": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(\\.(0|[1-9][0-9]*))?$"
    },
    "compiler_target": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "object",
      "properties": {
        "MACOSX_DEPLOYMENT_TARGET": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(\\.(0|[1-9][0-9]*))?$"
        },
        "ARCHFLAGS": {
          "const": "-arch arm64"
        },
        "SDKROOT": {
          "const": "@locked-sdk@"
        }
      },
      "required": [
        "MACOSX_DEPLOYMENT_TARGET",
        "ARCHFLAGS",
        "SDKROOT"
      ],
      "additionalProperties": false
    },
    "toolchain": {
      "type": "object",
      "properties": {
        "sdk": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "clang": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "clangxx": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "linker": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "ar": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "ranlib": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "python": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "pyinstaller": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9-]*$"
        }
      },
      "required": [
        "sdk",
        "clang",
        "clangxx",
        "linker",
        "ar",
        "ranlib",
        "python",
        "pyinstaller"
      ],
      "additionalProperties": false
    },
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "kind": {
            "enum": [
              "source-archive",
              "upstream-binary",
              "python-package",
              "toolchain"
            ]
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[0-9][A-Za-z0-9.+_-]*$"
          },
          "architecture": {
            "enum": [
              "arm64",
              "any"
            ]
          },
          "filename": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[0-9a-f]{64}$"
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "uniqueItems": true
          },
          "minimum_macos": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(\\.(0|[1-9][0-9]*))?$"
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "version",
          "architecture",
          "filename",
          "url",
          "sha256",
          "requires"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "status",
    "source_snapshot_sha256",
    "architecture",
    "deployment_target",
    "compiler_target",
    "environment",
    "toolchain",
    "dependencies"
  ],
  "additionalProperties": false
}
